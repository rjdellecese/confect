{
  "name": "confect-local-backend",
  "description": "Shared local Convex backend harness for integration tests.",
  "version": "0.0.0",
  "devDependencies": {
    "@effect/platform-node": "4.1.0",
    "@types/node": "26.6.6",
    "convex": "1.49.0",
    "cross-env": "10.1.0",
    "effect": "4.1.0",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "vitest": "5.1.0"
  },
  "exports": {
    "./LocalBackend": "./src/LocalBackend.ts",
    "./refs": "./fixtures/confect/_generated/refs.ts",
    "./setupForFixture": "./src/setupForFixture.ts",
    "./vitest": "./src/vitest.ts"
  },
  "private": true,
  "scripts": {
    "clean": "shx rm -rf node_modules",
    "codegen": "cd fixtures && pnpm confect codegen && cross-env CONVEX_AGENT_MODE=anonymous pnpm convex dev --once --typecheck=disable --tail-logs=disable",
    "typecheck": "tsrs --project tsconfig.json",
    "typecheck:inexact": "tsrs --project tsconfig.json --exactOptionalPropertyTypes false"
  },
  "type": "module"
}
