{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
  "plugins": [
    "typescript",
    "unicorn",
    "import",
    "promise",
    "node",
    "oxc",
    "effecttsgo"
  ],
  "jsPlugins": [
    "confect-oxlint-rules",
    { "name": "jsdoc-style", "specifier": "eslint-plugin-jsdoc" }
  ],
  "settings": {
    "jsdoc": {
      "tagNamePreference": { "typeParam": "typeParam" }
    }
  },
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "deny"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "**/node_modules/**",
    "**/.pnpm-store/**",
    "**/.tsup/**",
    "**/_generated/**",
    "**/.mintlify/**"
  ],
  "rules": {
    "confect/require-query-stream-experimental": "error",
    "jsdoc-style/check-alignment": "error",
    "jsdoc-style/check-line-alignment": [
      "error",
      "never",
      {
        "disableWrapIndent": true,
        "preserveMainDescriptionPostDelimiter": true
      }
    ],
    "jsdoc-style/no-multi-asterisks": ["error", { "allowWhitespace": true }],
    "jsdoc-style/require-asterisk-prefix": "error",
    "jsdoc-style/require-hyphen-before-param-description": [
      "error",
      "always",
      { "tags": { "template": "always", "typeParam": "always" } }
    ],
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "no-underscore-dangle": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",
    "oxc/no-accumulating-spread": "off",
    "typescript/consistent-return": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-unnecessary-type-assertion": "off",
    "typescript/no-unnecessary-type-arguments": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    "effecttsgo/any-unknown-in-error-context": "error",
    "effecttsgo/deterministic-keys": "error",
    "effecttsgo/strict-effect-provide": "off",
    "effecttsgo/async-function": "warn",
    "effecttsgo/crypto-random-uuid": "warn",
    "effecttsgo/crypto-random-uuid-in-effect": "warn",
    "effecttsgo/extends-native-error": "warn",
    "effecttsgo/global-console": "warn",
    "effecttsgo/global-console-in-effect": "warn",
    "effecttsgo/global-date": "warn",
    "effecttsgo/global-date-in-effect": "warn",
    "effecttsgo/global-fetch": "warn",
    "effecttsgo/global-fetch-in-effect": "warn",
    "effecttsgo/global-random": "warn",
    "effecttsgo/global-random-in-effect": "warn",
    "effecttsgo/global-timers": "warn",
    "effecttsgo/global-timers-in-effect": "warn",
    "effecttsgo/instance-of-schema": "warn",
    "effecttsgo/new-promise": "warn",
    "effecttsgo/node-builtin-import": "warn",
    "effecttsgo/process-env": "warn",
    "effecttsgo/process-env-in-effect": "warn",
    "effecttsgo/schema-class-missing-brand": "off",
    "effecttsgo/unstable-api-usage": "off",
    "effecttsgo/effect-try-without-catch": "off",
    "typescript/no-generated-empty-object-type": "off",
    "effecttsgo/global-json-in-effect": "warn",
    "effecttsgo/match-to-result-or-option": "off"
  },
  "overrides": [
    {
      "files": ["packages/js/test/HttpClient.test.ts"],
      "rules": { "effecttsgo/run-effect-inside-effect": "off" }
    },
    {
      "files": [
        "packages/cli/src/Evaluation.ts",
        "packages/cli/test/Evaluation.test.ts"
      ],
      "rules": {
        "effecttsgo/node-builtin-import": "off"
      }
    },
    {
      "files": ["**/*.{ts,tsx,mts,cts}"],
      "rules": {
        "typescript/consistent-type-imports": "error",
        "no-shadow": "error"
      }
    },
    {
      "files": ["**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}"],
      "rules": {
        "unicorn/filename-case": [
          "error",
          { "cases": { "camelCase": true, "pascalCase": true } }
        ]
      }
    },
    {
      "files": ["**/*.{ts,tsx,mts,cts}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "effect",
                "message": "Import Effect modules from their submodule path so they tree-shake, e.g. `import * as Schema from \"effect/Schema\"`. Bare helpers (pipe, flow, identity) come from \"effect/Function\".",
                "allowTypeImports": true
              }
            ],
            "patterns": [
              {
                "group": ["@effect/*", "!@effect/vitest", "!@effect/tsgo/**"],
                "message": "Import @effect/* modules from their submodule path so they tree-shake, e.g. `import * as Path from \"@effect/platform/Path\"`.",
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.spec.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "effect",
                "message": "Import Effect modules from their submodule path so they tree-shake, e.g. `import * as Schema from \"effect/Schema\"`. Bare helpers (pipe, flow, identity) come from \"effect/Function\".",
                "allowTypeImports": true
              },
              {
                "name": "@confect/server",
                "message": "Spec modules are bundled into the client, so anything they import ships to the browser. Move server logic into a `*.impl.ts` module, or use `import type` if you only need the types.",
                "allowTypeImports": true
              }
            ],
            "patterns": [
              {
                "group": ["@effect/*", "!@effect/vitest"],
                "message": "Import @effect/* modules from their submodule path so they tree-shake, e.g. `import * as Path from \"@effect/platform/Path\"`.",
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.test.{ts,tsx,mts,cts}"],
      "rules": {
        "confect/prefer-effect-vitest": "error",
        "confect/prefer-test-each": "error"
      }
    }
  ]
}
