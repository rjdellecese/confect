{
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@changesets/config": "4.0.1",
    "@effect/platform-bun": "4.1.0",
    "@effect/platform-node": "4.1.0",
    "@effect/tsgo": "0.67.5",
    "@types/bun": "1.4.4",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "concurrently": "10.0.7",
    "confect-oxlint-rules": "workspace:*",
    "cross-env": "10.1.0",
    "dpdm": "4.3.0",
    "effect": "4.1.0",
    "eslint-plugin-jsdoc": "65.4.5",
    "opensrc": "0.7.3",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "shx": "0.4.0",
    "skills": "1.7.6",
    "syncpack": "15.3.3",
    "tsdown": "0.23.7",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "tsx": "4.23.15",
    "unrun": "0.3.1",
    "vite-plus": "1.5.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.0"
  },
  "keywords": [
    "convex",
    "effect"
  ],
  "license": "ISC",
  "packageManager": "pnpm@12.16.1",
  "scripts": {
    "build": "vp run --cache --filter \"@confect/*\" build",
    "check": "bun run scripts/syncSkillIgnore.ts --check && bun run scripts/streamDiagrams.ts --check && effect-tsgo --tsrs-lint vp check",
    "check:consumers": "bun run scripts/checkConsumers.ts",
    "check:pack-contents": "bun run scripts/checkPackContents.ts",
    "circular": "dpdm --no-warning --no-tree --exit-code circular:1 -T \"packages/*/src/**/*.ts\"",
    "clean": "pnpm -r run clean && bun run scripts/clean.ts node_modules",
    "codegen:local-backend": "pnpm --filter confect-local-backend codegen",
    "codegen:server:mock-backend": "pnpm --filter @confect/server codegen:mock-backend",
    "dev": "concurrently --prefix-colors \"white.bold.bgBlue,white.bold.bgMagenta\" --names \"JS,DTS\" \"vp run --filter '@confect/*' --parallel dev\" \"tsrs -b tsconfig.packages.json --watch --preserveWatchOutput\"",
    "dev:docs": "pnpm --filter docs dev",
    "dev:example": "pnpm --filter example dev",
    "docs:stream-diagrams": "bun run scripts/streamDiagrams.ts",
    "format": "bun run scripts/syncSkillIgnore.ts && bun run scripts/streamDiagrams.ts && vp fmt && syncpack format",
    "format:check": "bun run scripts/syncSkillIgnore.ts --check && bun run scripts/streamDiagrams.ts --check && vp fmt --check && syncpack format --check",
    "lint": "effect-tsgo --tsrs-lint vp lint && syncpack lint",
    "lint:fix": "effect-tsgo --tsrs-lint vp lint --fix && syncpack fix",
    "oxlint": "effect-tsgo --tsrs-lint oxlint",
    "prepare": "effect-tsgo patch --tsrs --no-typescript --no-oxlint",
    "release": "pnpm build && changeset publish",
    "skills": "bun run scripts/manageSkills.ts",
    "skills:sync-ignore": "bun run scripts/syncSkillIgnore.ts",
    "test": "bun test ./scripts && vitest run",
    "test:js:local-backend": "pnpm --filter @confect/js test:local-backend",
    "test:server:local-backend": "pnpm --filter @confect/server test:local-backend",
    "test:server:mock-backend": "pnpm --filter @confect/server test:mock-backend",
    "typecheck": "tsrs -b tsconfig.packages.json tsconfig.json packages/cli/bin/tsconfig.json tools/oxlint-rules/tsconfig.json && pnpm --filter confect-test-types typecheck",
    "typecheck:inexact": "tsrs -b tsconfig.packages.json && vp run --filter \"@confect/*\" --filter confect-test-types --filter confect-local-backend typecheck:inexact",
    "version-packages": "changeset version && pnpm format"
  }
}
