{
  "name": "@confect/core",
  "description": "Shared specs and schemas used by all Confect packages",
  "version": "10.0.0-next.10",
  "author": "RJ Dellecese",
  "bugs": {
    "url": "https://github.com/rjdellecese/confect/issues"
  },
  "devDependencies": {
    "@ark/attest": "0.56.3",
    "@effect/vitest": "4.0.0-beta.105",
    "@types/node": "26.1.2",
    "effect": "4.0.0-beta.105",
    "tsdown": "0.22.14",
    "tsx": "4.23.8",
    "typescript": "6.0.3",
    "unrun": "0.3.1",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json",
    "./internal/*": null
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist",
    "package.json",
    "src"
  ],
  "homepage": "https://confect.dev",
  "keywords": [
    "convex",
    "effect"
  ],
  "license": "ISC",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "peerDependencies": {
    "convex": "^1.32.0",
    "effect": "^4.0.0-beta.105"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rjdellecese/confect.git"
  },
  "scripts": {
    "bench": "tsx test/Refs.bench.ts",
    "clean": "shx rm -rf dist coverage node_modules",
    "dev": "tsdown --watch --config-loader unrun",
    "postpack": "shx rm -f ./README.md && shx mv ./.README.md.bak ./README.md",
    "prepack": "shx mv ./README.md ./.README.md.bak && shx cp ../../README.md ./README.md",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.src.json"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts"
}
