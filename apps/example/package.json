{
  "name": "example",
  "version": "0.0.0",
  "dependencies": {
    "@confect/cli": "workspace:*",
    "@confect/core": "workspace:*",
    "@confect/react": "workspace:*",
    "@confect/server": "workspace:*",
    "@convex-dev/workpool": "0.4.14",
    "convex": "1.49.0",
    "convex-helpers": "0.1.134",
    "effect": "4.1.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.6"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "concurrently": "10.0.7",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "vite-plus": "1.5.0"
  },
  "private": true,
  "scripts": {
    "build": "vite build --mode development",
    "clean": "shx rm -rf dist node_modules",
    "convex-codegen": "pnpm convex codegen --typecheck=disable && tsrs --noEmit --project convex/tsconfig.json",
    "dev": "concurrently --restart-tries=1 --prefix-colors=\"white.bold.bgCyan,white.bold.bgYellow,white.bold.bgGreen,white.bold.bgMagenta\" --prefix=\" {name} \" --names=\"VITE,CONVEX,CONFECT,TYPES\" \"vite\" \"convex dev --tail-logs --typecheck=disable\" \"confect dev\" \"pnpm typecheck:watch\"",
    "typecheck": "tsrs --noEmit --project tsconfig.json && tsrs --noEmit --project convex/tsconfig.json",
    "typecheck:inexact": "tsrs --noEmit --project tsconfig.json --exactOptionalPropertyTypes false --tsBuildInfoFile node_modules/.cache/tsrs/tsconfig.inexact.tsbuildinfo && tsrs --noEmit --project convex/tsconfig.json --exactOptionalPropertyTypes false",
    "typecheck:watch": "tsrs -b tsconfig.json convex/tsconfig.json --noEmit --watch --preserveWatchOutput"
  },
  "type": "module"
}
