{
  "name": "@confect/server",
  "description": "Backend bindings to the Convex platform",
  "version": "10.6.0",
  "author": "RJ Dellecese",
  "bugs": {
    "url": "https://github.com/rjdellecese/confect/issues"
  },
  "dependencies": {
    "@effect/ai-openai-compat": "4.1.0",
    "@effect/ai-openrouter": "4.1.0"
  },
  "devDependencies": {
    "@effect/platform-node": "4.1.0",
    "@effect/tsgo": "0.67.5",
    "@effect/vitest": "4.1.0",
    "@swc/jest": "0.2.39",
    "@types/node": "26.6.6",
    "@vitest/coverage-v8": "5.1.0",
    "confect-bench-harness": "workspace:*",
    "confect-local-backend": "workspace:*",
    "confect-test-types": "workspace:*",
    "convex-test": "0.0.71",
    "dotenv": "18.0.9",
    "effect": "4.1.0",
    "jose": "6.2.16",
    "tsdown": "0.23.7",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "tsx": "4.23.15",
    "unrun": "0.3.1",
    "vite": "8.3.6",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json",
    "./internal/*": null,
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist",
    "!dist/*.tsbuildinfo",
    "package.json",
    "src"
  ],
  "homepage": "https://confect.dev",
  "keywords": [
    "convex",
    "effect"
  ],
  "license": "ISC",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "peerDependencies": {
    "@confect/core": "workspace:^",
    "@effect/platform-node": "~4.1.0",
    "convex": "^1.48.0",
    "effect": "~4.1.0"
  },
  "peerDependenciesMeta": {
    "@effect/platform-node": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rjdellecese/confect.git"
  },
  "scripts": {
    "bench": "tsx test/SchemaToValidator.bench.ts --checker tsrs && tsx test/Document.bench.ts --checker tsrs && tsx test/QueryStream.bench.ts --checker tsrs",
    "clean": "shx rm -rf dist coverage node_modules",
    "codegen:mock-backend": "cd test/mock-backend/fixtures && pnpm confect codegen && cross-env CONVEX_AGENT_MODE=anonymous pnpm convex dev --once --typecheck=disable --tail-logs=disable",
    "dev": "tsdown --watch --no-clean --config-loader unrun",
    "postpack": "shx rm -f ./README.md && shx mv ./.README.md.bak ./README.md",
    "prepack": "shx mv ./README.md ./.README.md.bak && shx cp ../../README.md ./README.md",
    "test": "vitest run",
    "test:local-backend": "vitest run --config vitest.local-backend.config.ts",
    "test:mock-backend": "vitest run --config vitest.mock-backend.config.ts",
    "typecheck": "tsrs -b tsconfig.src.json",
    "typecheck:inexact": "tsrs --noEmit --project tsconfig.json --exactOptionalPropertyTypes false"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts"
}
