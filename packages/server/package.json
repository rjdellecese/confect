{
  "name": "@confect/server",
  "description": "Backend bindings to the Convex platform",
  "version": "10.0.0-next.21",
  "author": "RJ Dellecese",
  "bugs": {
    "url": "https://github.com/rjdellecese/confect/issues"
  },
  "dependencies": {
    "@effect/ai-openai-compat": "4.0.0-rc.112"
  },
  "devDependencies": {
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/vitest": "4.0.0-rc.112",
    "@swc/jest": "0.2.39",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "confect-bench-harness": "workspace:*",
    "convex-test": "0.0.56",
    "dotenv": "17.4.2",
    "effect": "4.0.0-rc.112",
    "tsdown": "0.22.14",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "unrun": "0.3.1",
    "vite": "8.2.2",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json",
    "./internal/*": null,
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist",
    "!dist/*.tsbuildinfo",
    "package.json",
    "src"
  ],
  "homepage": "https://confect.dev",
  "keywords": [
    "convex",
    "effect"
  ],
  "license": "ISC",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "peerDependencies": {
    "@confect/core": "workspace:^",
    "@effect/platform-node": "^4.0.0-rc.112",
    "convex": "^1.45.0",
    "effect": "^4.0.0-rc.112"
  },
  "peerDependenciesMeta": {
    "@effect/platform-node": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rjdellecese/confect.git"
  },
  "scripts": {
    "bench": "tsx test/SchemaToValidator.bench.ts && tsx test/Document.bench.ts && tsx test/QueryStream.bench.ts",
    "clean": "shx rm -rf dist coverage node_modules",
    "codegen:local-backend": "cd test/local-backend/fixtures && pnpm confect codegen && cross-env CONVEX_AGENT_MODE=anonymous pnpm convex dev --once --typecheck=disable --tail-logs=disable",
    "codegen:mock-backend": "cd test/mock-backend/fixtures && pnpm confect codegen && cross-env CONVEX_AGENT_MODE=anonymous pnpm convex dev --once --typecheck=disable --tail-logs=disable",
    "dev": "tsdown --watch --no-clean --config-loader unrun",
    "postpack": "shx rm -f ./README.md && shx mv ./.README.md.bak ./README.md",
    "prepack": "shx mv ./README.md ./.README.md.bak && shx cp ../../README.md ./README.md",
    "test": "vitest run",
    "test:local-backend": "vitest run --config vitest.local-backend.config.ts",
    "test:mock-backend": "vitest run --config vitest.mock-backend.config.ts",
    "typecheck": "tsc -b tsconfig.src.json"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts"
}
