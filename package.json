{
  "devDependencies": {
    "@changesets/cli": "3.0.1",
    "@changesets/config": "4.0.0",
    "@effect/platform-bun": "4.0.0-rc.112",
    "@effect/platform-node": "4.0.0-rc.112",
    "@effect/tsgo": "0.38.0",
    "@types/bun": "1.3.14",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "concurrently": "10.0.5",
    "confect-oxlint-rules": "workspace:*",
    "cross-env": "10.1.0",
    "dpdm": "4.3.0",
    "effect": "4.0.0-rc.112",
    "opensrc": "0.7.3",
    "oxfmt": "0.65.0",
    "oxlint": "1.80.0",
    "oxlint-tsgolint": "7.0.2001",
    "shx": "0.4.0",
    "skills": "1.5.23",
    "syncpack": "15.3.3",
    "tsdown": "0.22.14",
    "typescript": "7.0.2",
    "unrun": "0.3.1",
    "vite-plus": "0.3.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11"
  },
  "keywords": [
    "convex",
    "effect"
  ],
  "license": "ISC",
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "build": "vp run --cache --filter \"@confect/*\" build",
    "check": "bun run scripts/syncSkillIgnore.ts --check && vp check",
    "check:pack-contents": "node scripts/checkPackContents.mjs",
    "check:prerelease-sync": "node scripts/auditPrereleaseSync.mjs",
    "circular": "dpdm --no-warning --no-tree --exit-code circular:1 -T \"packages/*/src/**/*.ts\"",
    "clean": "pnpm -r run clean && node scripts/clean.mjs node_modules",
    "codegen:server:local-backend": "pnpm --filter @confect/server codegen:local-backend",
    "codegen:server:mock-backend": "pnpm --filter @confect/server codegen:mock-backend",
    "dev": "concurrently --prefix-colors \"white.bold.bgBlue,white.bold.bgMagenta\" --names \"JS,DTS\" \"vp run --filter '@confect/*' --parallel dev\" \"tsc -b tsconfig.packages.json --watch --preserveWatchOutput\"",
    "dev:docs": "pnpm --filter docs dev",
    "dev:example": "pnpm --filter example dev",
    "format": "bun run scripts/syncSkillIgnore.ts && vp fmt && syncpack format",
    "format:check": "bun run scripts/syncSkillIgnore.ts --check && vp fmt --check && syncpack format --check",
    "lint": "vp lint && syncpack lint",
    "lint:fix": "vp lint --fix && syncpack fix",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "release": "pnpm build && changeset publish",
    "skills": "bun run scripts/manageSkills.ts",
    "skills:sync-ignore": "bun run scripts/syncSkillIgnore.ts",
    "test": "bun test scripts/syncSkillIgnore.test.ts && node --test scripts/auditPrereleaseSync.test.mjs && vitest run",
    "test:prerelease-sync": "node --test scripts/auditPrereleaseSync.test.mjs",
    "test:server:local-backend": "pnpm --filter @confect/server test:local-backend",
    "test:server:mock-backend": "pnpm --filter @confect/server test:mock-backend",
    "typecheck": "tsc -b tsconfig.packages.json tsconfig.json tools/oxlint-rules/tsconfig.json",
    "version-packages": "changeset version && pnpm format"
  }
}
