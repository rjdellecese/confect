          "icon": "database",
          "anchor": "Convex Docs",
          "href": "https://docs.convex.dev"
        }
      ]
    },
    "groups": [
      {
        "group": "Getting Started",
        "pages": ["getting-started/introduction", "getting-started/quickstart"]
      },
      {
        "group": "Concepts",
        "pages": [
          "concepts/packages",
          "concepts/project-structure",
          "concepts/spec-impl-model",
          "concepts/file-naming-conventions",
          "concepts/services",
          "concepts/schema-restrictions"
