{
  "name": "@confect/alchemy",
  "description": "Alchemy resources for deploying Convex and Confect applications",
  "version": "10.0.0-next.24",
  "author": "RJ Dellecese",
  "bugs": {
    "url": "https://github.com/rjdellecese/confect/issues"
  },
  "dependencies": {
    "@convex-dev/platform": "^0.1.10"
  },
  "devDependencies": {
    "@confect/cli": "workspace:*",
    "@effect/platform-node": "4.0.0-rc.117",
    "@effect/vitest": "4.0.0-rc.117",
    "@types/node": "24.13.3",
    "alchemy": "2.0.0-beta.79",
    "convex": "1.45.0",
    "effect": "4.0.0-rc.117",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "unrun": "0.3.1",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json",
    "./internal/*": null
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist",
    "!dist/*.tsbuildinfo",
    "package.json",
    "src"
  ],
  "homepage": "https://confect.dev",
  "keywords": [
    "alchemy",
    "convex",
    "effect"
  ],
  "license": "ISC",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "peerDependencies": {
    "@confect/cli": "workspace:^",
    "alchemy": "2.0.0-beta.79",
    "convex": "^1.32.0",
    "effect": "^4.0.0-rc.117"
  },
  "peerDependenciesMeta": {
    "@confect/cli": {
      "optional": true
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rjdellecese/confect.git",
    "directory": "packages/alchemy"
  },
  "scripts": {
    "clean": "shx rm -rf dist coverage node_modules",
    "dev": "tsdown --watch --no-clean --config-loader unrun",
    "test": "vitest run",
    "typecheck": "tsc -b tsconfig.src.json",
    "typecheck:inexact": "tsc --noEmit --project tsconfig.json --exactOptionalPropertyTypes false"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts"
}
