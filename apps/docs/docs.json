          "server/scheduling",
          "server/authentication",
          "server/metadata",
          "server/cron-jobs",
          "server/search",
          "server/components",
          "server/environment-variables"
        ]
      },
      {
        "group": "Clients",
        "pages": [
          "clients/react",
          {
            "icon": "js",
            "group": "JS",
            "pages": ["clients/js/http", "clients/js/websocket"]
          },
          "clients/foldkit"
        ]
      },
      {
        "group": "Guides",
        "pages": ["guides/testing"]
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "icon": "github",
        "label": "GitHub",
        "href": "https://github.com/rjdellecese/confect"
