{
  "name": "@confect/core",
  "description": "Shared specs and schemas used by all Confect packages",
  "version": "10.5.0",
  "author": "RJ Dellecese",
  "bugs": {
    "url": "https://github.com/rjdellecese/confect/issues"
  },
  "devDependencies": {
    "@effect/vitest": "4.1.0",
    "@types/node": "26.6.6",
    "confect-bench-harness": "workspace:*",
    "effect": "4.1.3",
    "tsdown": "0.23.7",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "tsx": "4.23.15",
    "unrun": "0.3.1",
    "vitest": "5.1.0"
  },
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    },
    "./package.json": "./package.json",
    "./internal/*": null
  },
  "files": [
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "dist",
    "!dist/*.tsbuildinfo",
    "package.json",
    "src"
  ],
  "homepage": "https://confect.dev",
  "keywords": [
    "convex",
    "effect"
  ],
  "license": "ISC",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "peerDependencies": {
    "convex": "^1.32.0",
    "effect": "^4.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rjdellecese/confect.git"
  },
  "scripts": {
    "bench": "tsx test/Refs.bench.ts --checker tsrs && tsx test/Types.bench.ts --checker tsrs",
    "clean": "shx rm -rf dist coverage node_modules",
    "dev": "tsdown --watch --no-clean --config-loader unrun",
    "postpack": "shx rm -f ./README.md && shx mv ./.README.md.bak ./README.md",
    "prepack": "shx mv ./README.md ./.README.md.bak && shx cp ../../README.md ./README.md",
    "test": "vitest run",
    "typecheck": "tsrs -b tsconfig.src.json",
    "typecheck:inexact": "tsrs --noEmit --project tsconfig.json --exactOptionalPropertyTypes false"
  },
  "sideEffects": false,
  "type": "module",
  "types": "./dist/index.d.ts"
}
