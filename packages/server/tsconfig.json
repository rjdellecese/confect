{
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "isolatedDeclarations": false,
    "noEmit": true,
    "skipLibCheck": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["ESNext", "DOM"],
    "target": "ESNext",
    "moduleResolution": "Bundler",
    "module": "ESNext",
    "paths": {
      "@confect/server": ["./src/index.ts"],
      "@confect/server/*": ["./src/*"],
      "~/*": ["./test/mock-backend/fixtures/confect/*"]
    }
  },
  "exclude": [
    "coverage",
    "dist",
    "node_modules",
    // Convex emits unused imports and an incorrect nested API import in these
    // unused helpers. Imported ComponentApi types remain in the checked graph.
    "test/local-backend/fixtures/components/*/convex/_generated"
  ],
  "extends": ["../../tsconfig.base.json"]
}
