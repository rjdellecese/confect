          "server/functions",
          "server/error-handling",
          "server/middleware",
          "server/plain-convex-functions",
          "server/node-actions",
          "server/ai-gateway",
          {
            "icon": "database",
            "group": "Database",
            "pages": [
              "server/database/schema",
              "server/database/reading",
              "server/database/streams",
              "server/database/writing",
              "server/database/system-tables",
              "server/database/determinism"
