{
  "$schema": "./node_modules/@effect/tsgo/oxlint-schema.json",
  "extends": ["./node_modules/@effect/tsgo/oxlint-presets/recommended.json"],
  "plugins": [
    "typescript",
    "unicorn",
    "import",
    "promise",
    "node",
    "oxc",
    "effecttsgo"
  ],
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "deny"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "**/node_modules/**",
    "**/.pnpm-store/**",
    "**/.tsup/**",
    "**/_generated/**",
    "**/.mintlify/**"
  ],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "no-underscore-dangle": "off",
    "unicorn/consistent-function-scoping": "off",
    "unicorn/no-array-sort": "off",
    "oxc/no-accumulating-spread": "off",
    "typescript/consistent-return": "off",
    "typescript/no-unsafe-type-assertion": "off",
    "typescript/no-unnecessary-type-assertion": "off",
    "typescript/no-unnecessary-type-arguments": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    "effecttsgo/any-unknown-in-error-context": "error",
    "effecttsgo/deterministic-keys": "error",
    "effecttsgo/strict-effect-provide": "off"
  },
  "overrides": [
    {
      "files": ["**/*.{ts,tsx,mts,cts}"],
      "rules": {
        "typescript/consistent-type-imports": "error",
        "no-shadow": "error"
      }
    },
    {
      "files": ["**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts}"],
      "rules": {
        "unicorn/filename-case": [
          "error",
          { "cases": { "camelCase": true, "pascalCase": true } }
        ]
      }
    },
    {
      "files": ["**/*.{ts,tsx,mts,cts}"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "effect",
                "message": "Import Effect modules from their submodule path so they tree-shake, e.g. `import * as Schema from \"effect/Schema\"`. Bare helpers (pipe, flow, identity) come from \"effect/Function\".",
                "allowTypeImports": true
              }
            ],
            "patterns": [
              {
                "group": ["@effect/*", "!@effect/vitest", "!@effect/tsgo/**"],
                "message": "Import @effect/* modules from their submodule path so they tree-shake, e.g. `import * as Path from \"@effect/platform/Path\"`.",
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/*.spec.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "effect",
                "message": "Import Effect modules from their submodule path so they tree-shake, e.g. `import * as Schema from \"effect/Schema\"`. Bare helpers (pipe, flow, identity) come from \"effect/Function\".",
                "allowTypeImports": true
              },
              {
                "name": "@confect/server",
                "message": "Spec modules are bundled into the client, so anything they import ships to the browser. Move server logic into a `*.impl.ts` module, or use `import type` if you only need the types.",
                "allowTypeImports": true
              }
            ],
            "patterns": [
              {
                "group": ["@effect/*", "!@effect/vitest"],
                "message": "Import @effect/* modules from their submodule path so they tree-shake, e.g. `import * as Path from \"@effect/platform/Path\"`.",
                "allowTypeImports": true
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "packages/core/src/SchemaToValidator.ts",
        "packages/core/src/SystemFields.ts",
        "packages/foldkit/test/TestClient.ts",
        "packages/server/src/RegisteredConvexFunction.ts",
        "packages/server/src/RegisteredFunction.ts",
        "packages/server/test/Document.test.ts",
        "packages/server/test/mock-backend/fixtures/confect/groups/runners.impl.ts",
        "packages/server/test/mock-backend/fixtures/confect/http.ts",
        "packages/server/test/mock-backend/fixtures/confect/middleware/ProvideViewer.impl.ts"
      ],
      "rules": {
        "effecttsgo/any-unknown-in-error-context": "off"
      }
    }
  ]
}
